# Sarvam (dashboard.sarvam.ai)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=translit
SARVAM_TTS_MODEL=bulbul:v3

# Shared secret Sarvam agent tools send in the X-Tool-Secret header
AGENT_TOOL_SECRET=change-me

# Paths (relative to repo root)
RAW_DATA_DIR=data/private/raw/gc
WAREHOUSE_PATH=data/private/warehouse.duckdb
SESSIONS_DB_PATH=data/private/sessions.sqlite

# LLM brain: one structured Sarvam LLM call per seller turn (understand + reply)
LLM_BRAIN=true
# Convert Roman Hinglish replies to Devanagari before Bulbul (decide with: python -m vani.tools.tts_compare)
TTS_TRANSLITERATE=false
